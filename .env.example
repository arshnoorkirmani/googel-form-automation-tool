APP_NAME=Dispositions Form Automation
APP_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeElvHr-D5FXndyGFdk5VrcNKprY_wakDRGlmNJytjInZRaUA/viewform
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dispositions_form_automation
AUTH_SESSION_KEY=default
# Set to false on Render. Keep true only on a trusted local workstation
# that you use for manual Google session bootstrap.
AUTH_INTERACTIVE_SETUP_ENABLED=true
DEFAULT_MODE=DRY_RUN
MAX_BATCH_ROWS=50
DEBUG_SLOW_MO_MS=250
MAX_RETRIES=2
# These stay false by default to avoid local storage bloat.
PERSIST_LOG_FILES=false
PERSIST_SCREENSHOTS=false
PERSIST_RUN_REPORTS=false
