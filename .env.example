# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Dispositions Form Automation
APP_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeElvHr-D5FXndyGFdk5VrcNKprY_wakDRGlmNJytjInZRaUA/viewform

# Public URL of the deployed app — required for any absolute URL generation on Render.
# Leave blank for local development (relative URLs are used instead).
# Example: https://your-service-name.onrender.com
# Port used by the Next.js server. Render assigns this automatically.
# Leave blank locally (Next.js defaults to 3000).
PORT=

# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Set to "production" on Render. This automatically:
#   - Disables all local file persistence (logs, screenshots, reports)
#   - Skips ephemeral local directory creation
#   - Disables interactive browser auth setup

# ─────────────────────────────────────────────────────────────────────────────
# MONGODB (required on render-production branch)
# ─────────────────────────────────────────────────────────────────────────────
# Supported formats:
#   mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
#   mongodb://host1:27017,host2:27017,host3:27017/database?replicaSet=...
MONGODB_URI=
MONGODB_DB_NAME=dispositions_form_automation

# ─────────────────────────────────────────────────────────────────────────────
# AUTH / SESSION
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SESSION_KEY=default

# Set to false on Render — interactive Google login must be done locally first.
# The saved session is then stored in MongoDB and reused by the cloud server.
AUTH_INTERACTIVE_SETUP_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# AUTOMATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_MODE=DRY_RUN
MAX_BATCH_ROWS=50
DEBUG_SLOW_MO_MS=250
MAX_RETRIES=2

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL FILE PERSISTENCE (ignored/forced false when NODE_ENV=production)
# ─────────────────────────────────────────────────────────────────────────────
PERSIST_LOG_FILES=false
PERSIST_SCREENSHOTS=false
PERSIST_RUN_REPORTS=false
