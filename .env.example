# Copy this file to .env.local for local development.
# Only the variables below are used by the app runtime.

# Restricted Google Form URL to automate.
APP_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeElvHr-D5FXndyGFdk5VrcNKprY_wakDRGlmNJytjInZRaUA/viewform

# Current app flow supports SUBMIT mode.
DEFAULT_MODE=SUBMIT

# Allowed values: slow | normal | fast
AUTOMATION_SPEED_MODE=normal

# Debug browser slow motion in milliseconds.
DEBUG_SLOW_MO_MS=250

# Pre-submit automation retries.
MAX_RETRIES=2

# Store screenshots and JSON reports under storage/artifacts.
PERSIST_SCREENSHOTS=false
PERSIST_RUN_REPORTS=false
